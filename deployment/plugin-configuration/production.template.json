{
  "apiVersion": "multiforum.gennit.dev/v1alpha1",
  "plugins": [
    {
      "pluginId": "security-attachment-scan",
      "version": "0.5.1",
      "enabled": true,
      "settingsJson": {
        "serviceUrl": "__SCAN_SERVICE_URL__",
        "blockOn": "malicious",
        "onError": "block",
        "policy": {}
      },
      "secretRefs": [
        {
          "key": "SCAN_SERVICE_API_KEY",
          "valueFrom": "env:SCAN_API_KEY"
        }
      ]
    },
    {
      "pluginId": "llm-moderation",
      "version": "0.8.0",
      "enabled": true,
      "settingsJson": {
        "serviceUrl": "__LLM_MODERATION_SERVICE_URL__",
        "serverRuleEnforcement": "__SERVER_RULE_ENFORCEMENT__",
        "channelRuleEligibility": "allowlist",
        "channelRuleAllowlist": ["__LLM_MODERATION_TRIAL_FORUM__"],
        "model": "gpt-4o",
        "temperature": 0,
        "maxTokens": 800,
        "confidenceThreshold": 0.7,
        "serviceTimeoutMs": 30000,
        "botName": "llm-moderator"
      },
      "secretRefs": [
        {
          "key": "MODERATION_SERVICE_API_KEY",
          "valueFrom": "env:MOD_API_KEY"
        }
      ]
    }
  ],
  "channelPlugins": [
    {
      "channelUniqueName": "__LLM_MODERATION_TRIAL_FORUM__",
      "pluginId": "llm-moderation",
      "version": "0.8.0",
      "enabled": true
    }
  ],
  "pipelines": [
    {
      "event": "downloadableFile.created",
      "steps": [{ "pluginId": "security-attachment-scan", "version": "0.5.1" }],
      "stopOnFirstFailure": true,
      "applicability": "ALL_FILES_IMMEDIATE"
    },
    {
      "event": "downloadableFile.updated",
      "steps": [{ "pluginId": "security-attachment-scan", "version": "0.5.1" }],
      "stopOnFirstFailure": true,
      "applicability": "ALL_FILES_IMMEDIATE"
    },
    {
      "event": "downloadableFile.downloaded",
      "steps": [{ "pluginId": "security-attachment-scan", "version": "0.5.1" }],
      "stopOnFirstFailure": true,
      "applicability": "ALL_FILES_IMMEDIATE"
    },
    {
      "event": "comment.created",
      "steps": [{ "pluginId": "llm-moderation", "version": "0.8.0" }],
      "stopOnFirstFailure": true
    },
    {
      "event": "comment.edited",
      "steps": [{ "pluginId": "llm-moderation", "version": "0.8.0" }],
      "stopOnFirstFailure": true
    },
    {
      "event": "discussionChannel.created",
      "steps": [{ "pluginId": "llm-moderation", "version": "0.8.0" }],
      "stopOnFirstFailure": true
    },
    {
      "event": "discussionChannel.edited",
      "steps": [{ "pluginId": "llm-moderation", "version": "0.8.0" }],
      "stopOnFirstFailure": true
    }
  ]
}
