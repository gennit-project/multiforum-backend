exports[`actual middleware preserves pre-resolver revision commits, attribution and native events (resolver rejects=false) 1`] = `
{
  "calls": [
    [
      "activity",
      "edited the event description",
      1
    ],
    [
      "activity",
      "edited the event title",
      1
    ],
    [
      "notify",
      {
        "notificationType": "general",
        "text": "editor edited your event [old title](undefined/forums/forum/events/e)",
        "username": "poster"
      }
    ],
    [
      "resolve"
    ]
  ],
  "state": {
    "event": [
      {
        "description": "new description",
        "editor": "editor",
        "title": "new title"
      }
    ],
    "revisions": [
      {
        "author": "editor",
        "body": "old title",
        "kind": "HAS_TITLE_VERSION",
        "touched": true
      },
      {
        "author": "prior",
        "body": "old description",
        "kind": "HAS_DESCRIPTION_VERSION",
        "touched": true
      }
    ]
  }
}
`;

