{
  "name": "multiforum-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "test": "node --import tsx --import ./tests/helpers/snapshotSerializer.ts --test $(find . -path './node_modules' -prune -o -path './.claude' -prune -o -path './coverage' -prune -o -path './ts_emitted' -prune -o -path './tests/integration' -prune -o -name '*test.ts' -print | sort)",
    "test:integration": "TESTCONTAINERS_REUSE_ENABLE=true node --import tsx --import ./tests/helpers/snapshotSerializer.ts --test --test-concurrency=1 $(find ./tests/integration -name '*test.ts' -print 2>/dev/null | sort)",
    "coverage": "c8 --exclude-after-remap --exclude='rules/permission/userDataHelperFunctions.ts' node --import tsx --import ./tests/helpers/snapshotSerializer.ts --test $(find . -path './node_modules' -prune -o -path './.claude' -prune -o -path './coverage' -prune -o -path './ts_emitted' -prune -o -path './tests/integration' -prune -o -name '*test.ts' -print | sort)",
    "coverage:startup-provisioning": "c8 --exclude-after-remap --include='services/startupProvisioning.ts' --reports-dir=coverage/startup-provisioning node --test ts_emitted/services/startupProvisioning.test.js",
    "coverage:request-user": "c8 --exclude-after-remap --include='rules/permission/userDataHelperFunctions.ts' --reports-dir=coverage/request-user node --test ts_emitted/rules/permission/userDataHelperFunctions.test.js",
    "coverage:integration": "TESTCONTAINERS_REUSE_ENABLE=true c8 --exclude-after-remap --exclude='rules/permission/userDataHelperFunctions.ts' node --import tsx --import ./tests/helpers/snapshotSerializer.ts --test --test-concurrency=1 $(find ./tests/integration -name '*test.ts' -print 2>/dev/null | sort)",
    "test:integration:shard": "bash build_scripts/integration-shard.sh",
    "coverage:merged": "bash build_scripts/coverage-merged.sh",
    "prepare": "husky",
    "codegen": "node --import tsx build_scripts/generateTypes.ts",
    "lint": "eslint .",
    "lint:circular": "madge --circular --extensions ts --exclude 'ogm_types.ts|src/generated' index.ts customResolvers.ts permissions.ts",
    "tsc": "tsc",
    "logSchema": "node build_scripts/logSchema.js",
    "migrate:private-downloads": "node --import tsx build_scripts/migratePrivateDownloads.ts",
    "migrate:plugin-pipelines": "node --import tsx build_scripts/migrateLegacyPluginPipelines.ts",
    "migrate:discussion-flair-ownership": "node --import tsx build_scripts/migrateDiscussionFlairOwnership.ts",
    "migrate:wiki-page-ownership": "node --import tsx build_scripts/migrateWikiPageOwnership.ts",
    "migrate:channel-role-ownership": "node --import tsx build_scripts/migrateChannelRoleOwnership.ts",
    "migrate:issue-targets": "node --import tsx build_scripts/migrateIssueTargets.ts",
    "migrate:critical-properties": "node --import tsx build_scripts/migrateCriticalProperties.ts",
    "provision": "node --import tsx build_scripts/provisionServerDefaults.ts",
    "age-gate:sweep": "node ts_emitted/build_scripts/ageGateSweep.js",
    "age-gate:sweep:dev": "node --import tsx build_scripts/ageGateSweep.ts",
    "neo4j:audit": "node --import tsx build_scripts/neo4jSchemaAudit.ts",
    "perf:cypher": "node --import tsx build_scripts/profileCriticalQueries.ts",
    "neo4j:cleanup-intermediate-nodes": "node --import tsx build_scripts/cleanupIntermediateNodes.ts",
    "mfctl": "node --import tsx build_scripts/pluginConfigurationCli.ts",
    "build": "pnpm run codegen && tsc && node build_scripts/copyCypherFiles.js",
    "heroku-postbuild": "NODE_OPTIONS=--max-old-space-size=2048 pnpm run build",
    "start": "node ./ts_emitted/index.js",
    "perf:pipeline-summary": "node --expose-gc --import tsx build_scripts/profilePipelineSummary.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@google-cloud/storage": "^8.4.0",
    "@graphql-tools/delegate": "12.3.0",
    "@graphql-tools/schema": "^11.0.6",
    "@neo4j/graphql": "^7.6.4",
    "@sendgrid/mail": "^8.1.4",
    "@types/tar-stream": "^3.1.4",
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "graphql": "^17.0.2",
    "graphql-depth-limit": "^1.1.0",
    "graphql-middleware": "^6.1.35",
    "graphql-query-complexity": "^2.0.0",
    "graphql-shield": "7.6.5",
    "graphql-tag": "^2.12.7",
    "graphql-type-json": "^0.3.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.0.1",
    "luxon": "^3.5.0",
    "markdown-it": "^15.0.3",
    "mathjs": "^15.2.0",
    "ncp": "^2.0.0",
    "neo4j-driver": "6.2.0",
    "node-cache": "^5.1.2",
    "random-word-slugs": "^0.1.7",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@testcontainers/neo4j": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/luxon": "3.7.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "whatwg-url": "^11.0.0",
      "tr46": "^4.1.0",
      "lodash": "^4.18.0",
      "uuid": "^11.1.1",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "fast-xml-parser": "^5.10.1",
      "postcss": "^8.5.25",
      "protobufjs@7": "^7.6.5",
      "shell-quote": "^1.11.0",
      "undici": "^8.10.2",
      "follow-redirects": "^1.16.1",
      "source-map-js": "^1.2.2",
      "proxy-addr": "^2.0.8",
      "@fastify/busboy": "^3.2.2",
      "@grpc/grpc-js": "^1.14.5",
      "@graphql-tools/executor-legacy-ws": "^1.1.35",
      "@graphql-tools/utils": "^12.0.1",
      "qs": "^6.16.0",
      "js-yaml": "^4.3.2"
    },
    "ignoredBuiltDependencies": [
      "@apollo/protobufjs",
      "cpu-features",
      "protobufjs",
      "ssh2"
    ],
    "patchedDependencies": {
      "graphql-shield@7.6.5": "patches/graphql-shield@7.6.5.patch"
    }
  }
}
